# Generate .env with python3 scripts/configure.py; never commit actual credentials.
DATABASE_URL=jdbc:postgresql://127.0.0.1:55432/orderops
DATABASE_USER=orderops
DATABASE_PASSWORD=replace-with-a-random-password
JWT_SECRET=replace-with-at-least-32-random-bytes
ADMIN_EMAIL=admin@orderops.local
ADMIN_PASSWORD=replace-with-at-least-12-characters
FORECAST_URL=http://127.0.0.1:8000
